# ============================================================
# CONFIGURACIÓN AFIP - TEMPLATE
# ============================================================
# Copia este archivo a .env y completa con tus valores

# CUIT de la empresa (sin guiones, 11 dígitos)
# Obtén tu CUIT en https://www.afip.gob.ar
AFIP_CUIT=20123456789

# Ruta al certificado AFIP (archivo .crt descargado de AFIP)
# En producción: /etc/lumenanalitica/afip_certs/certificate.crt
# En desarrollo: ./afip_certs/certificate.crt
AFIP_CERT_PATH=./afip_certs/certificate.crt

# Ruta a la clave privada AFIP (archivo .pem generado localmente)
# En producción: /etc/lumenanalitica/afip_certs/private_key.pem
# En desarrollo: ./afip_certs/private_key.pem
AFIP_KEY_PATH=./afip_certs/private_key.pem

# Modo producción (true) o staging/testing (false)
# Usa 'false' para pruebas iniciales, 'true' solo cuando esté verificado
AFIP_PRODUCTION=false

# Timeout para consultas AFIP (segundos)
AFIP_API_TIMEOUT=30

# Número de reintentos en caso de error de conexión
AFIP_MAX_RETRIES=2

# ============================================================
# CONFIGURACIÓN GENERAL
# ============================================================

# Base de datos SQLite
DB_PATH=./data/creditdb.sqlite

# Nivel de logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Archivo de log
LOG_FILE=./logs/app.log

# Timeout para consultas BCRA (segundos)
BCRA_TIMEOUT=30

# Clave secreta para Streamlit (cambiar en producción)
STREAMLIT_SECRET_KEY=dev-secret-key-change-in-production
